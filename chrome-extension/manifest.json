{
  "manifest_version": 3,
  "name": "Persona Stream — вкладка X",
  "version": "0.3.1",
  "description": "Подключает выбранную вкладку X к локальному Persona Stream. Без доступа к cookies и паролям.",
  "permissions": ["activeTab", "scripting", "debugger"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": {"default_title": "Подключить вкладку X", "default_popup": "popup.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:4317"}
}
